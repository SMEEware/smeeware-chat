# Smeeware backend. Only DEEPSEEK_API_KEY is required; every empty key
# keeps its feature switched off. ./install.sh fills this in for you.
# All keys and settings: backend/README.md

# --- Required ---
DEEPSEEK_API_KEY=

# --- Optional keys ---
# GPT models, image generation, voice input
OPENAI_API_KEY=
# Natural read-aloud voices (without it: a free, English-only voice)
ELEVENLABS_API_KEY=
# Web and image search
BRAVE_API_KEY=
# Short sourced answers (separate Brave plan)
BRAVE_ANSWERS_API_KEY=
# Google Maps, YouTube search and transcripts
SERPAPI_API_KEY=
# Bug bounty programs (needs both)
HACKERONE_API_USERNAME=
HACKERONE_API_TOKEN=

# --- Features ---
# Lets the model run shell commands. Not sandboxed: local, single-user only.
SHELL_ENABLED=false
# Allow sudo/su in the shell tool; actual privileges still depend on the OS.
ROOT=false
# gpt-transcribe (needs OPENAI_API_KEY) or whisper-local (on this machine)
TRANSCRIBE_MODEL=gpt-transcribe
# Local models through Ollama, e.g. OLLAMA_MODEL=qwen3:8b
OLLAMA_ENABLED=false
OLLAMA_MODEL=
# S3 bucket through the mc client (alias from `mc alias list`)
STORAGE_ENABLED=false
STORAGE_ALIAS=
STORAGE_BUCKET=llm
STORAGE_PUBLIC_BASE=

# --- Server ---
# Random string; encrypts shared chats. Sharing stays off while it is empty.
SECRET=
# true when the backend itself is reachable from the internet
REQUIRE_API_KEY=false
