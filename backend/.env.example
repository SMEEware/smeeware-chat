# ---- Anwendung -------------------------------------------------------------
# Diese Vorlage ist auf den SERVER eingestellt (Docker). Lokal ist das egal:
# start.sh setzt ENVIRONMENT selbst (dev = mit Reload) und uebergeht diesen Wert.
ENVIRONMENT=production           # development | staging | production
DEBUG=false                      # auf dem Server aus; lokal setzt start.sh dev
HOST=127.0.0.1                   # privat -- im Docker erreichbar nur uebers Frontend
PORT=8000
# Der Browser spricht nur das Frontend an, das Backend bleibt privat -- CORS
# spielt hier praktisch keine Rolle. Komma-getrennt, wenn doch noetig.
CORS_ORIGINS=*

# ---- LLM -------------------------------------------------------------------
LLM_PROVIDER=deepseek            # Schluessel aus src/services/ai/providers/__init__.py
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-chat
# Hinweis: Bei allen *_TIMEOUT gilt 0 = kein Zeitlimit -- lange Antworten,
# Streams und Werkzeuglaeufe brechen dann nicht ab. Der Client (Stop-Knopf /
# Seitenwechsel) bleibt die Bremse; ein Herzschlag haelt den Stream offen.
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ---- Das Geheimnis ----------------------------------------------------------
# Beliebiger String. Loesung der dritten Aufgabe; wird in den System-Prompt
# eingesetzt. Ohne Angabe: 0815
SECRET=0815

# ---- System-Prompts ---------------------------------------------------------
# Dateien in prompts/. Dateiname ohne Endung = Name. Pro Anfrage per
# "prompt": "<name>" oder "system_prompt": "<text>" ueberschreibbar.
PROMPTS_DIR=prompts
DEFAULT_PROMPT=default

# ---- Lokale Werkzeuge -------------------------------------------------------
# Ohne Schluessel wird das jeweilige Werkzeug einfach weggelassen.
BRAVE_API_KEY=                   # web_search UND image_search
SERPAPI_API_KEY=
# Brave Answers: eigenes Abo, eigener Schluessel. Liefert eine belegte
# KI-Antwort in einem Aufruf -- redundant zu web_search+fetch_page, lohnt nur
# fuer schnelle Faktenfragen. Auf false, wenn du lieber selbst recherchierst.
BRAVE_ANSWERS_API_KEY=
BRAVE_ANSWERS_ENABLED=true

# HackerOne: Bug-Bounty-Programme durchsuchen und Reports schreiben.
# Benutzername UND Token stammen aus derselben API-Token-Einstellung;
# der Benutzername ist ein Bezeichner, kein Login. Fehlt eins, werden die
# hackerone_* Werkzeuge weggelassen.
HACKERONE_API_USERNAME=
HACKERONE_API_TOKEN=
# Reports live absenden statt nur entwerfen. Standard aus.
HACKERONE_ALLOW_SUBMIT=false
TOOL_HTTP_TIMEOUT=20

# Scraping (fetch_page, extract_selectors, extract_tables, list_links,
# fetch_json, batch_fetch). Das Modell waehlt die URLs -- deshalb Grenzen:
SCRAPE_MAX_BYTES=2000000     # Download-Limit je Seite, gegen Riesendateien
SCRAPE_MAX_CHARS=12000       # Zeichen, die ein Werkzeug hoechstens ausgibt
SCRAPE_CACHE_TTL=300         # Sekunden, die eine geholte Seite gilt (0 = aus)
SCRAPE_CONCURRENCY=4         # parallele Abrufe bei batch_fetch
SCRAPE_HOST_DELAY=0.25       # Mindestabstand zwischen zwei Anfragen je Host

# ---- Vision ------------------------------------------------------------------
# Eigenes Modell fuer Bilder. Das Hauptmodell ist blind und ruft es ueber das
# Werkzeug analyze_image auf; derselbe Dienst haengt an POST /api/v1/vision.
# Ohne eigenen Schluessel/Basis-URL wird der des Hauptproviders genommen.
VISION_ENABLED=true
VISION_MODEL=deepseek-v4-flash-vision-exp
VISION_API_KEY=
VISION_BASE_URL=
VISION_DETAIL=auto              # low | high | original | auto
VISION_MAX_IMAGES=8             # je Aufruf (die API erlaubt bis 600)
VISION_MAX_BYTES=33554432       # 32 MiB, das Limit der API je Bild
VISION_MAX_TOKENS=2000
VISION_TIMEOUT=120
VISION_CACHE_TTL=900            # gleiches Bild + gleiche Frage nicht neu zahlen

# ---- Eigener Speicher (mc / S3) ---------------------------------------------
# Nutzt das mc-Binary und dessen Alias aus ~/.mc/config.json -- die
# Zugangsdaten bleiben dort und stehen nie in dieser Datei.
# Einmalig einzurichten:
#   mc mb smeeware/llm
#   mc anonymous set download smeeware/llm
STORAGE_ENABLED=true
MC_BINARY=mc
STORAGE_ALIAS=smeeware              # Alias aus `mc alias list`
STORAGE_BUCKET=llm                  # Bucket, den das Modell bespielen darf
STORAGE_PREFIX=                     # optionaler Unterordner darin
STORAGE_PUBLIC_BASE=https://storage.smeeware.com
MC_CONFIG_DIR=                      # nur noetig, wenn ~/.mc nicht passt
STORAGE_TIMEOUT=120
STORAGE_MAX_INLINE=200000           # Zeichen fuer storage_put(content=...)
STORAGE_MAX_BYTES=50000000          # Bytes fuer storage_put(local_path=...)
# Leer = Uploads von ueberall (nur eine Sperrliste schuetzt). Sobald der
# Endpunkt von aussen erreichbar ist, hier ein Verzeichnis eintragen:
STORAGE_LOCAL_ROOT=

# ---- Skills -----------------------------------------------------------------
# Arbeitsanweisungen, die das Modell selbst pflegt. Vertrauenswuerdige liegen
# im Repo (skills/, in git), modell-gepflegte lokal unter data/skills -- kein
# Bucket, kein mc mehr. Der Ordner entsteht beim ersten Speichern von selbst.
SKILLS_ENABLED=true
SKILLS_DIR=skills
SKILLS_DATA_DIR=data/skills
SKILLS_CACHE_TTL=300

# run_shell laeuft mit den Rechten des Serverprozesses und ist NICHT
# sandboxed: es fuehrt aus, was das Modell schreibt -- und das Modell folgt
# dem, was im Chat steht. Wer den Chat teilt, gibt damit die Shell aus der
# Hand. Die Sperrliste ist nur eine Stolperschwelle, kein Zaun. Deshalb
# Vorgabe false; nur lokal und allein einschalten, nie auf einer geteilten
# oder oeffentlichen Instanz.
SHELL_ENABLED=false
SHELL_TIMEOUT=30
SHELL_WORKDIR=
SHELL_MAX_OUTPUT=8000

# ---- Chat-Verlaeufe ---------------------------------------------------------
# Persistenz der Verlaeufe in einer SQLite-Datei (wird samt Verzeichnis beim
# Start angelegt). Der Chat selbst bleibt zustandslos -- das Frontend vergibt
# die ID und schickt den vollen Verlauf per PUT /api/v1/chats/{id}.
# Auf false: die /chats-Endpunkte antworten dann mit 500 statt still zu
# schlucken, was gespeichert werden sollte.
CHATS_ENABLED=true
CHATS_DB_PATH=data/chats.db

# ---- Zugang / API-Schluessel ------------------------------------------------
# Verlangen die Inferenz-Endpunkte (chat, transcribe, vision) einen Ausweis?
# Vorgabe false: lokal, hinter localhost, soll ein blankes curl weiter
# funktionieren. Wer das Backend oeffentlich stellt, setzt dies auf true --
# dann braucht jede Anfrage entweder eine offene Sitzung (das eigene Frontend)
# oder einen gueltigen API-Schluessel im "Authorization: Bearer <key>"-Kopf.
# Schluessel legt man im Frontend an (Einstellungen -> API keys); in der
# Datenbank liegt nur ihr Hash, nie der Schluessel selbst.
REQUIRE_API_KEY=false

# ---- OpenAI ----------------------------------------------------------------
# Die gpt-5.6-Familie, die Bilderzeugung und die Transkription haengen alle an
# diesem einen Schluessel. Fehlt er, faellt jeweils weg, was ihn braucht --
# die OpenAI-Gruppe im Modell-Auswahlfeld, das Werkzeug generate_image und
# die gehosteten Transkriptions-Modelle. Der Rest laeuft unveraendert weiter.
#
# Diese Modelle sprechen die Responses-API, nicht Chat-Completions. Das ist
# keine Vorliebe: auf Chat-Completions schliessen sich Werkzeuge und
# Reasoning bei gpt-5.6 gegenseitig aus, sofern der Denkaufwand nicht auf
# "none" steht -- und genau beides zusammen ist der Grund fuer diese Modelle.
OPENAI_API_KEY=sk-proj-...
OPENAI_ENABLED=true
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-5.6-terra   # nur ohne Angabe -- der Katalog nennt sonst das Modell
# Wie viel gedacht wird, wenn der Katalog nichts vorgibt:
#   none | minimal | low | medium | high | xhigh | max
OPENAI_REASONING_EFFORT=medium
# "detailed" und nicht "auto": mit "auto" liefern diese Modelle in der Praxis
# gar keinen Gedankengang, und ein leeres Denkfenster ist schlechter als keins.
OPENAI_REASONING_SUMMARY=detailed
OPENAI_TIMEOUT=600              # 0 = kein Zeitlimit; "max" denkt minutenlang
OPENAI_MAX_RETRIES=1

# Hinweis zu gpt-5.6-cyber, daybreak-red und daybreak-blue: die stehen im
# Katalog, brauchen aber eine Freischaltung des Kontos bei OpenAI. Ohne sie
# antwortet die API mit "model does not exist" -- das Auswahlfeld sagt das
# vorher, damit die Meldung im Chat nicht aus dem Nichts kommt.

# ---- Bilder erzeugen --------------------------------------------------------
# Das Werkzeug generate_image. Es laeuft ueber die Images-API und schickt
# waehrend der Erzeugung Zwischenstaende ueber den Ereignis-Bus in den
# Browser -- bei IMAGE_QUALITY=high sind das ungefaehr drei Stueck auf gut
# zwei Minuten. Ohne sie saehe man zwei Minuten lang nichts.
IMAGE_ENABLED=true
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1024            # 1024x1024 | 1536x1024 | 1024x1536 | auto
IMAGE_QUALITY=high              # low | medium | high | auto -- low ist ~20s, high ~2min
# png und NICHT webp: mit webp liefert die API ueberhaupt keine
# Zwischenstaende, nur das fertige Bild. Wer hier umstellt, schaltet die
# Live-Vorschau stumm ab.
IMAGE_FORMAT=png
IMAGE_PARTIALS=3                # 0..3 -- mehr gibt die API nicht her
IMAGE_MODERATION=auto           # auto | low
IMAGE_TIMEOUT=300

# Referenzbilder. Liegen welche an, geht die Anfrage an /images/edits statt
# /images/generations -- trotz des Namens ist das der Weg fuer "nimm diese
# Bilder als Vorlage", nicht bloss fuer Retusche. Er streamt genauso.
#
# Als Vorlage zugelassen sind nur Dateien aus dem Anhang-Ordner (was der
# Nutzer angehaengt oder das Modell selbst erzeugt hat) und http(s)-Adressen.
# Ein beliebiger Pfad waere ein Weg, jede Datei der Maschine an einen fremden
# Dienst zu schicken -- und den Pfad waehlt das Modell, nicht der Nutzer.
IMAGE_MAX_REFERENCES=4          # 0 schaltet Vorlagen ganz ab
IMAGE_REFERENCE_MAX_BYTES=50000000   # Grenze der API je Eingabebild

# Ablage im Bucket: jedes erzeugte Bild wandert zusaetzlich unter
# llm/generated/ und traegt dort Datum und Motiv im Namen. Damit findet das
# Modell seine eigenen Bilder mit storage_list wieder und raeumt sie mit
# storage_delete auf.
#
# ACHTUNG: der Bucket ist oeffentlich lesbar (STORAGE_PUBLIC_BASE). Was hier
# landet, liegt unter einer erratbaren Adresse im Netz. IMAGE_ARCHIVE=false
# laesst die Bilder nur lokal unter data/uploads -- im Chat werden sie
# ohnehin von dort geladen, angezeigt wird also weiterhin alles.
IMAGE_ARCHIVE=true
IMAGE_ARCHIVE_PREFIX=generated

# ---- Lokale Modelle (Ollama) -------------------------------------------------
# Laufen NEBEN dem gehosteten Anbieter, nicht statt ihm: LLM_PROVIDER waehlt
# weiter die Ferne, die lokalen Modelle haengen unabhaengig davon daran.
#
# OPT-IN und ZWEI Schalter: ein lokales Modell taucht im Auswahlfeld erst auf,
# wenn OLLAMA_ENABLED=true UND OLLAMA_MODEL gesetzt sind -- und wenn Ollama
# gerade antwortet. Fehlt eins davon, gibt es schlicht kein lokales Modell
# (kein Eintrag, der beim ersten Klick ins Leere laeuft). id und Anzeige-Tag im
# Auswahlfeld kommen direkt aus OLLAMA_MODEL; nichts weiter ist einzutragen.
#
# WELCHES Modell: eins, das DENKEN UND WERKZEUGE kann -- sonst bleiben halbe
# Funktionen dunkel. Beispiele: qwen3:8b, llama3.1:8b.
OLLAMA_ENABLED=false           # true, um lokale Modelle ueberhaupt anzubieten
OLLAMA_MODEL=                  # z.B. qwen3:8b -- der Tag, den `ollama pull` kennt
OLLAMA_BASE_URL=http://localhost:11434/v1  # im Docker (Host-Netz) unveraendert gueltig;
                               # 127.0.0.1:11434 trifft Host-Ollama UND den ollama-Container
OLLAMA_API_KEY=ollama          # Ollama prueft ihn nicht, der Client will einen
OLLAMA_TIMEOUT=600             # ein 30B-MoE legt beim ersten Aufruf ~21 GB in den Speicher
OLLAMA_MAX_RETRIES=0           # ein Wiederholen hiesse, denselben Kaltstart nochmal zahlen
# OLLAMA_DEFAULT_MODEL bleibt als aelterer Alias von OLLAMA_MODEL gueltig.
#
# Zwei Dinge lassen sich NICHT von hier aus stellen -- gemessen, nicht geraten:
#   keep_alive  wird ueber den OpenAI-kompatiblen /v1-Endpunkt ignoriert. Damit
#               das Modell zwischen zwei Fragen geladen bleibt, den Ollama-
#               Server mit OLLAMA_KEEP_ALIVE=30m starten. Sonst faellt es nach
#               5 Minuten raus und der naechste Turn wartet auf den Kaltstart.
#   num_ctx     haengt ebenfalls am Server; ollama ps zeigt, was wirklich gilt
#               (hier 32768, obwohl das Modell 262144 koennte).

# ---- Spracheingabe (whisper.cpp) --------------------------------------------
# Gesprochenes zu Text. Zwei Wege, in den Einstellungen umschaltbar.
#
# Warum nicht die Spracherkennung des Browsers: die verlangt, dass man die
# Sprache VORHER waehlt. Beide Wege hier erkennen sie selbst -- genau darum
# geht es bei mehrsprachiger Eingabe.
#
# TRANSCRIBE_MODEL nennt einen Eintrag aus src/services/audio/catalog.py und
# entscheidet damit zugleich, WER transkribiert:
#   gpt-transcribe          genauester, meldet die gehoerte Sprache mit
#   gpt-4o-transcribe       solider Allrounder
#   gpt-4o-mini-transcribe  schneller und billiger
#   whisper-1               das klassische gehostete Whisper
#   whisper-local           whisper.cpp -- die Aufnahme bleibt auf der Maschine
#
# Die ersten vier brauchen OPENAI_API_KEY, der letzte die beiden Programme
# unten. Was fehlt, faellt aus der Auswahl -- eine Option, die sicher
# scheitert, ist keine.
TRANSCRIBE_MODEL=gpt-transcribe
#
# Voraussetzungen fuer whisper-local:
#   brew install whisper-cpp ffmpeg
#   curl -L -o data/models/ggml-large-v3-turbo.bin \
#     https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin
#
# Fehlt eines davon, meldet GET /api/v1/transcribe das -- und das Frontend
# blendet das Mikrofon aus, statt einen Knopf zu zeigen, der sicher scheitert.
TRANSCRIBE_ENABLED=true
WHISPER_BINARY=whisper-cli
FFMPEG_BINARY=ffmpeg
WHISPER_MODEL=data/models/ggml-large-v3-turbo.bin
WHISPER_THREADS=0               # 0 = whisper.cpp entscheidet selbst
TRANSCRIBE_TIMEOUT=120
TRANSCRIBE_MAX_BYTES=25000000   # 25 MB je Aufnahme

# ---- Vorlesen (Text-zu-Sprache) ---------------------------------------------
# Das Werkzeug read_aloud spricht Antworten laut vor -- der Browser zeigt dabei
# eine Sprechanzeige, die zum Ton ausschlaegt. Es funktioniert IMMER: liegt ein
# ELEVENLABS_API_KEY vor, spricht ElevenLabs (viele Sprachen, versteht
# Lautschrift wie /ɡluːˈkoʊs/); fehlt er, faellt es auf eine gratis Stimme
# zurueck (Google-Uebersetzer, ohne Anmeldung, englisch).
#
# ELEVENLABS_VOICE_ID ist die Vorgabe-Stimme. Sie gilt nur fuer ElevenLabs und
# ist im Chat zur Laufzeit ueberschreibbar -- eigene Stimmen findet man im
# ElevenLabs-Dashboard (Voice Library / My Voices).
#
# TTS_MODEL nennt einen Eintrag aus src/services/speech/catalog.py:
#   eleven_multilingual_v2  die Vorgabe -- natuerlich, mehrsprachig, versteht IPA
#   eleven_turbo_v2_5       schneller und billiger
#   eleven_flash_v2_5       niedrigste Latenz
#   eleven_v3               am ausdrucksstaerksten
#   free-google             gratis Rueckfall, ohne Schluessel
TTS_ENABLED=true
ELEVENLABS_API_KEY=            # leer lassen -> gratis Rueckfall
ELEVENLABS_VOICE_ID=DDpANZ8PLYsm2RvgHVlV
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
TTS_MODEL=eleven_multilingual_v2
TTS_FREE_LANGUAGE=en           # Sprache des gratis Rueckfalls (ElevenLabs erkennt sie selbst)
TTS_TIMEOUT=120
TTS_MAX_CHARS=5000             # eine Vorlese-Anfrage ist kein Hoerbuch

# ---- Anhaenge ---------------------------------------------------------------
# Dateien, die im Chat an den Prompt gehaengt werden. Bilder landen hier auf
# der Platte; in die Nachricht wandert nur der Pfad, den der Agent an
# analyze_image weitergibt. (Textdateien braucht das gar nicht -- die faltet
# das Frontend direkt in den Prompt.) Auf false: POST /api/v1/uploads
# antwortet mit 500 statt Dateien anzunehmen, die niemand ansehen kann.
UPLOADS_ENABLED=true
UPLOADS_DIR=data/uploads
UPLOADS_MAX_BYTES=20000000      # 20 MB je Datei
UPLOADS_MAX_FILES=8             # je Anfrage

# ---- MCP-Werkzeuge ----------------------------------------------------------
# Serverliste in mcp.json (Format wie Claude Desktop)
MCP_ENABLED=true
MCP_CONFIG=mcp.json
MCP_CALL_TIMEOUT=60          # ein einzelner MCP-Werkzeugaufruf; 0 = kein Limit
# Werkzeugrunden je Antwort -- gilt fuer alle Werkzeuge, nicht nur MCP.
# Eine Scraping-Kette (suchen, Links holen, Seiten lesen) braucht mehrere.
MCP_MAX_TOOL_ROUNDS=8

# ---- Supabase (optional, noch nicht angebunden) -----------------------------
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY=
# SUPABASE_JWT_SECRET=
